{
  "name": "ible-projection-shell",
  "private": true,
  "version": "0.1.2",
  "description": "ProShow — projeção Electron + React",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts",
    "pack:mac": "vite build && electron-builder --mac --arm64",
    "pack:mac:x64": "vite build && electron-builder --mac --x64",
    "pack:win": "vite build && electron-builder --win --x64",
    "pack:linux": "vite build && electron-builder --linux --x64"
  },
  "build": {
    "appId": "app.proshow.projection",
    "productName": "ProShow",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json",
      "!data/**",
      "!release/**",
      "!src/**",
      "!tests/**"
    ],
    "extraResources": [
      {
        "from": "data/themes",
        "to": "data/themes"
      }
    ],
    "asarUnpack": [
      "**/@napi-rs/canvas-*/**",
      "**/grandi/**",
      "**/@ffprobe-installer/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "O ProShow usa a câmera para projetar imagem ao vivo no culto.",
        "NSMicrophoneUsageDescription": "O ProShow usa o microfone para o áudio da câmera ao vivo.",
        "LSUIElement": false
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo"
    }
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@napi-rs/canvas": "^1.0.2",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "grandi": "^2.0.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  }
}
